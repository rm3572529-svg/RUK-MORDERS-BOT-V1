# ---- Required ----
BOT_TOKEN=PASTE_YOUR_NEW_BOT_TOKEN_HERE
ADMIN_ID=YOUR_TELEGRAM_USER_ID
DATABASE_URL=YOUR_DATABASE_URL
SECRET_KEY=GENERATE_A_LONG_RANDOM_STRING
ADMIN_PANEL_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# ---- AI (optional but needed for screenshot analysis / smart search) ----
AI_PROVIDER=openai            # openai (any OpenAI-compatible API) | anthropic
AI_API_KEY=YOUR_AI_API_KEY
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=              # blank = same as AI_MODEL (must support images)

# ---- Hosting ----
PUBLIC_BASE_URL=https://your-app.onrender.com   # public https URL of this service
PORT=8000
STORAGE_CHAT_ID=              # chat/channel id where uploads are stored (blank = ADMIN_ID)
LOCAL_BOT_API_URL=            # e.g. http://localhost:8081 to lift the 50 MB limit

# ---- YouTube API verification (optional, recommended) ----
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
